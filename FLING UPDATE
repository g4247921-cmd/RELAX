local function resetCamera()
	pcall(function()
		local char = Player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			Workspace.CurrentCamera.CameraSubject = hum
			Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		end
	end)
end

local GetPlayer = function(Name)
	if not Name or Name == "" then return nil end
	Name = tostring(Name):lower()
	if Name == "all" or Name == "others" then
		AllBool = true
		return nil
	elseif Name == "random" then
		local GetPlayers = Players:GetPlayers()
		for i = #GetPlayers, 1, -1 do
			if GetPlayers[i] == Player then
				table.remove(GetPlayers, i)
			end
		end
		if #GetPlayers > 0 then
			return GetPlayers[math.random(#GetPlayers)]
		end
		return nil
	else
		for _, x in ipairs(Players:GetPlayers()) do
			if x ~= Player then
				if x.Name:lower():sub(1, #Name) == Name or x.DisplayName:lower():sub(1, #Name) == Name then
					return x
				end
			end
		end
	end
	return nil
end

-- Noclip Logic
local function toggleNoclip()
	noclipEnabled = not noclipEnabled
	if noclipEnabled then
		if Player.Character then
			for _, part in pairs(Player.Character:GetChildren()) do
				if part:IsA("BasePart") then
					originalCanCollide[part] = part.CanCollide
				end
			end
		end
		noclipConnection = RunService.Stepped:Connect(function()
			if Player.Character then
				for _, part in pairs(Player.Character:GetChildren()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end)
		Message("Noclip", "Enabled", 3)
	else
		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end
		if Player.Character then
			for _, part in pairs(Player.Character:GetChildren()) do
				if part:IsA("BasePart") then
					local originalValue = originalCanCollide[part]
					if originalValue ~= nil then
						part.CanCollide = originalValue
					else
						part.CanCollide = (part.Name ~= "HumanoidRootPart")
					end
				end
			end
		end
		originalCanCollide = {}
		Message("Noclip", "Disabled", 3)
	end
end

-- Anti-Fling
local function toggleAntiFling()
	antiFlingEnabled = not antiFlingEnabled
	if antiFlingEnabled then
		antiFlingConnection = RunService.Stepped:Connect(function()
			if not antiFlingEnabled then return end
			pcall(function()
				local char = Player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				
				if root and root.AssemblyLinearVelocity.Magnitude > 250 then
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
				end

				for _, otherPlayer in ipairs(Players:GetPlayers()) do
					if otherPlayer ~= Player and otherPlayer.Character then
						for _, otherPart in ipairs(otherPlayer.Character:GetChildren()) do
							if otherPart:IsA("BasePart") then
								otherPart.CanCollide = false
							end
						end
					end
				end
			end)
		end)
		Message("Anti-Fling", "Enabled (Normal Speed)", 3)
	else
		if antiFlingConnection then
			antiFlingConnection:Disconnect()
			antiFlingConnection = nil
		end
		Message("Anti-Fling", "Disabled", 3)
	end
end

-- 🔥 FIXED: FLING ON WALK (Membuat karakter tetap jalan biasa, tapi bisa menabrak & mem-fling player lain)
local function toggleFlingOnWalk()
	flingOnWalkEnabled = not flingOnWalkEnabled
	if flingOnWalkEnabled then
		flingOnWalkConnection = RunService.Heartbeat:Connect(function()
			if not flingOnWalkEnabled then return end
			pcall(function()
				local char = Player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					-- Memberikan rotasi physics ekstrem agar saat bersentuhan langsung mem-fling player lain
					root.AssemblyAngularVelocity = Vector3.new(0, 99999, 0)
				end
			end)
		end)
		Message("Fling On Walk", "ACTIVE: Nabrak player lain otomatis fling!", 3)
	else
		if flingOnWalkConnection then
			flingOnWalkConnection:Disconnect()
			flingOnWalkConnection = nil
		end
		pcall(function()
			local char = Player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end)
		Message("Fling On Walk", "Disabled", 3)
	end
end

-- 🔥 FIXED: SYSTEM FLING ENGINE (Pasti Fling & Anti-Stuck saat Attack All)
local SkidFling = function(TargetPlayer)
	if not TargetPlayer or not TargetPlayer.Character then return end
	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Humanoid and Humanoid.RootPart
	local TCharacter = TargetPlayer.Character
	local THumanoid = TCharacter and TCharacter:FindFirstChildOfClass("Humanoid")
	local TRootPart = THumanoid and THumanoid.RootPart

	if Character and Humanoid and RootPart and TRootPart then
		local oldCF = RootPart.CFrame
		
		-- Buat velocity booster modern
		local velocityObj = Instance.new("BodyAngularVelocity")
		velocityObj.Name = "FlingForce"
		velocityObj.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		velocityObj.AngularVelocity = Vector3.new(0, 999999, 0)
		velocityObj.Parent = RootPart

		Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

		local startTime = tick()
		-- Fling Loop singkat (1.2 detik per target agar Attack All berjalan cepat & lancar)
		repeat
			if RootPart and TRootPart then
				RootPart.CFrame = TRootPart.CFrame * CFrame.new(0, 0, 0) + TRootPart.Velocity * 0.1
				RootPart.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
			end
			task.wait()
		until not TRootPart or not TRootPart.Parent or TRootPart.AssemblyLinearVelocity.Magnitude > 400 or tick() - startTime > 1.2

		velocityObj:Destroy()
		Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)

		-- Reset posisi & camera
		pcall(function()
			RootPart.AssemblyLinearVelocity = Vector3.zero
			RootPart.AssemblyAngularVelocity = Vector3.zero
			RootPart.CFrame = oldCF
			if not spectating then resetCamera() end
		end)
	end
end

