--[[ Wood Functions ]]--

local Regions = {}
local CollectTreeRegions = function()
    for _, Region in ipairs(Workspace:GetChildren()) do
        if Region.Name == "TreeRegion" then
            table.insert(Regions, Region)
        end
    end
end
CollectTreeRegions()

local GetMass = function(Tree)
    local TreeMass = 0
    for _, Part in ipairs(Tree:GetDescendants()) do
        if Part:IsA("BasePart") and Part.Name == "WoodSection" then
            TreeMass = TreeMass + Part:GetMass()
        end
    end
    return TreeMass
end

local GetSections = function(Tree)
    local Sections = {}
    for _, Section in ipairs(Tree:GetDescendants()) do
        if Section.Name == "WoodSection" then
            table.insert(Sections, Section)
        end
    end
    table.sort(Sections, function(a, b)
        local idA = a:FindFirstChild("ID") and a.ID.Value or 0
        local idB = b:FindFirstChild("ID") and b.ID.Value or 0
        return idA > idB
    end)
    return Sections
end

local GetTreeClasses = function(TreeClass)
    local Available = {}
    for _, Region in ipairs(Regions) do
        for _, TreeModel in ipairs(Region:GetChildren()) do
            local owner = TreeModel:FindFirstChild("Owner")
            local tClass = TreeModel:FindFirstChild("TreeClass")
            if owner and owner.Value == nil and tClass and tClass.Value == TreeClass then
                table.insert(Available, TreeModel)
            end
        end
    end
    return Available
end

local FindLargestTree = function(TreeClass)
    local EligibleTrees = {}
    local Trees = GetTreeClasses(TreeClass)

    for _, Tree in ipairs(Trees) do
        local Sections = GetSections(Tree)
        if #Sections > 0 then
            table.insert(EligibleTrees, {Tree = Tree, Trunk = Sections[1], Mass = GetMass(Tree)})
        end
    end

    if #EligibleTrees == 0 then
        return false, "Failed to find tree"
    end

    table.sort(EligibleTrees, function(a, b)
        return a.Mass > b.Mass
    end)

    return EligibleTrees[1]
end

local AbortGetTree = false
local GetAxeModule = function(Axe)
    local AxeModule = ReplicatedStorage.AxeClasses:FindFirstChild("AxeClass_"..Axe)
    if not AxeModule then
        return false, "Failed to find axe module"
    end
    return require(AxeModule).new()
end

local GetAxeStats = function(Axe, TreeClass)
    local AxeStats, ErrorMsg = GetAxeModule(Axe)
    if ErrorMsg then
        return false, ErrorMsg
    end
    return AxeStats.SpecialTrees and AxeStats.SpecialTrees[TreeClass] or AxeStats
end

local GetAxes = function()
    local Axes = {}
    local CurrentAxe = Player.Character and Player.Character:FindFirstChild("Tool")
    if CurrentAxe then
        table.insert(Axes, CurrentAxe)
    end
    for _, Axe in ipairs(Player.Backpack:GetChildren()) do
        if Axe:FindFirstChild("CuttingTool") then
            table.insert(Axes, Axe)
        end
    end
    return Axes
end

local GetBestAxe = function(TreeClass)
    local Axes = GetAxes()
    if #Axes == 0 then
        return false, "Client owns 0 axes"
    end

    local AxeModules = {}
    for _, Axe in ipairs(Axes) do
        local toolName = Axe:FindFirstChild("ToolName") and Axe.ToolName.Value or "Basic Hatchet"
        local success, AxeModule = pcall(function()
            return GetAxeStats(toolName, TreeClass)
        end)
        if success and AxeModule then
            AxeModule.Axe = Axe
            table.insert(AxeModules, AxeModule)
        end
    end

    if #AxeModules == 0 then
        return false, "Failed to parse axe stats"
    end

    table.sort(AxeModules, function(a, b)
        return (a.Damage or 1) > (b.Damage or 1)
    end)

    return AxeModules[1]
end

local AttemptChop = function(Tree)
    local CutEvent = Tree:FindFirstChild("CutEvent")
    local Axe, ErrorMsg = GetBestAxe()
    if ErrorMsg or not Axe then
        return false, ErrorMsg
    end
    pcall(function()
        Remotes.RemoteProxy:Call(CutEvent, {
            ["tool"]         = Axe.Axe,
            ["hitPoints"]    = Axe.Damage or 1,
            ["faceVector"]   = Vector3.new(1, 0, 0),
            ["height"]       = 0.32,
            ["sectionId"]    = 1,
            ["cooldown"]     = Axe.SwingCooldown or 0.1,
            ["cuttingClass"] = "tool",
        })
    end)
    return true
end

local GetTree = function(TreeClass, Quantity)
    local BestAxe, ErrorMsg = GetBestAxe(TreeClass)
    if not BestAxe then return end

    local CurrentPosition = Player.Character.HumanoidRootPart.CFrame
    Quantity = Quantity or 1

    for i = 1, Quantity do
        if AbortGetTree then break end
        local Result, Err = FindLargestTree(TreeClass)
        if Err then continue end

        local Tree = Result.Tree
        local Trunk = Result.Trunk
        local LooseTree = nil

        local conn
        conn = Workspace.LogModels.ChildAdded:Connect(function(TreeModel)
            local owner = TreeModel:WaitForChild("Owner", 1)
            if owner and owner.Value == Player then
                LooseTree = TreeModel
                if conn then conn:Disconnect() end
            end
        end)

        repeat task.wait()
            if not Trunk or not Trunk.Parent then break end
            Teleport(CFrame.new(Trunk.CFrame.p) + Vector3.new(5, 1, 0))
            AttemptChop(Tree)
        until LooseTree or AbortGetTree

        if LooseTree and LooseTree:FindFirstChild("WoodSection") then
            MoveModel(LooseTree, CurrentPosition)
        end
        task.wait(0.2)
    end

    AbortGetTree = false
    Teleport(CurrentPosition)
end

