local isFlying = false
local FlyingSpeed = 50
local PlayerFly = function(Value)
    repeat task.wait() until Player and Player.Character and Player.Character:FindFirstChild('Head') and Player.Character:FindFirstChild('Humanoid')
    local Steer = {f = 0, b = 0, l = 0, r = 0}
    local BackSteer = {f = 0, b = 0, l = 0, r = 0}
    local MaxSpeed = 500
    
    if not Player.Character.Humanoid.SeatPart then
        Player.Character.Humanoid.PlatformStand = true
    end

    local CarFly = nil
    if Player.Character.Humanoid.SeatPart then
        CarFly = Player.Character.Humanoid.SeatPart
        local FlyWeldone = Instance.new("Weld", Player.Character.HumanoidRootPart)
        local FlyWeldtwo = Instance.new("Weld", CarFly)
        FlyWeldone.Part0 = Player.Character.HumanoidRootPart
        FlyWeldone.Part1 = CarFly
        FlyWeldtwo.Part0 = Player.Character.HumanoidRootPart
        FlyWeldtwo.Part1 = CarFly
    end

    local function Fly()
        local RootPart = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end
        
        local Gyro = Instance.new('BodyGyro', RootPart)
        Gyro.P = 9e4
        Gyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        Gyro.CFrame = RootPart.CFrame
        
        local Velocity = Instance.new('BodyVelocity', RootPart)
        Velocity.Velocity = Vector3.new(0, 0.1, 0)
        Velocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        local currentFlySpeed = FlyingSpeed
        repeat task.wait()
            if Steer.l + Steer.r ~= 0 or Steer.f + Steer.b ~= 0 then
                currentFlySpeed = FlyingSpeed
                if currentFlySpeed > MaxSpeed then currentFlySpeed = MaxSpeed end
            else
                currentFlySpeed = currentFlySpeed - 50
                if currentFlySpeed < 0 then currentFlySpeed = 0 end
            end
            
            local camCF = Workspace.CurrentCamera.CFrame
            if (Steer.l + Steer.r) ~= 0 or (Steer.f + Steer.b) ~= 0 then
                Velocity.Velocity = ((camCF.LookVector * (Steer.f + Steer.b)) + ((camCF * CFrame.new(Steer.l + Steer.r, (Steer.f + Steer.b) * .2, 0).p) - camCF.p)) * currentFlySpeed
                BackSteer = {f = Steer.f, b = Steer.b, l = Steer.l, r = Steer.r}
            elseif currentFlySpeed ~= 0 then
                Velocity.Velocity = ((camCF.LookVector * (BackSteer.f + BackSteer.b)) + ((camCF * CFrame.new(BackSteer.l + BackSteer.r, (BackSteer.f + BackSteer.b) * .2, 0).p) - camCF.p)) * currentFlySpeed
            else
                Velocity.Velocity = Vector3.new(0, 0.1, 0)
            end
            Gyro.CFrame = camCF * CFrame.Angles(-math.rad((Steer.f + Steer.b) * 50 * currentFlySpeed / MaxSpeed), 0, 0)
        until not isFlying
        
        Gyro:Destroy()
        Velocity:Destroy()
        pcall(function()
            if CarFly then
                for _, v in next, CarFly:GetChildren() do
                    if v.Name == 'Weld' then v:Destroy() end
                end
            end
            for _, v in next, RootPart:GetChildren() do
                if v:IsA('Weld') then v:Destroy() end
            end
            if CarFly then
                RootPart.CFrame = CFrame.new(CarFly.CFrame.p)
            end
        end)
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.PlatformStand = false
        end
    end

    Mouse.KeyDown:Connect(function(Key)
        Key = Key:lower()
        if Key == 'w' then Steer.f = 1
        elseif Key == 'a' then Steer.l = -1
        elseif Key == 's' then Steer.b = -1
        elseif Key == 'd' then Steer.r = 1 end
    end)
    
    Mouse.KeyUp:Connect(function(Key)
        Key = Key:lower()
        if Key == 'w' then Steer.f = 0
        elseif Key == 'a' then Steer.l = 0
        elseif Key == 's' then Steer.b = 0
        elseif Key == 'd' then Steer.r = 0 end
    end)

    if not Value then
        isFlying = false
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.PlatformStand = false
        end
    else
        isFlying = true
        task.spawn(Fly)
    end
end

