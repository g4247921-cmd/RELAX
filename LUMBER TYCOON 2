local IsNetworkOwner = function(ObjectModel)
    for _, BasePart in next, ObjectModel:GetDescendants() do
        if BasePart:IsA("BasePart") and BasePart.ReceiveAge == 0 and not BasePart:IsGrounded() then
            return true
        end
    end
    return false
end

local MoveModel = function(Model, Position)
    repeat task.wait()
        pcall(function()
            Remotes.ClientIsDragging:Call(Model)
        end)
    until IsNetworkOwner(Model) or not Model
    if Model then
        Model:PivotTo(Position)
    end
end

